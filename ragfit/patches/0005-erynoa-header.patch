diff --git a/lib/open_project/ragfit/erynoa_header.rb b/lib/open_project/ragfit/erynoa_header.rb
new file mode 100644
index 0000000..df38d02
--- /dev/null
+++ b/lib/open_project/ragfit/erynoa_header.rb
@@ -0,0 +1,70 @@
+# frozen_string_literal: true
+
+# RagFit patch 0005 (erynoa-header, 2026-10-14): Erynoa header above the OpenProject layout.
+# GPLv3 §10 modification, see CHANGES-RAGFIT.md.
+#
+# The vendored package public/erynoa/1.1.1/ (ErynoaGroup/.assets, tag erynoa-header-v1.1.1, MIT code; Erynoa
+# name and logo not licensed, see its NOTICE.md) is served unchanged as static files. This file only renders the
+# partial with the package's markup and resolves its placeholders at request time:
+# - domain: RAGFIT_ERYNOA_DOMAIN, otherwise the configured host name minus its first label
+#   (plan.<domain> -> <domain>). No host name is written into the repository.
+# - logo link: RAGFIT_ERYNOA_HOME_URL (https only), otherwise https://source.<domain>/
+# - skip link: #content-wrapper; current service: plan (aria-current="page")
+# - theme: data-erh-theme="dark|light" from the user's theme, none when it follows the OS
+# Without a resolvable domain nothing is rendered. Works without JavaScript (the package JS is not used).
+module OpenProject
+  module Ragfit
+    module ErynoaHeader
+      VERSION = "1.1.1"
+      ASSET_PATH = "/erynoa/#{VERSION}".freeze
+      SERVICES = %w[source plan memory docs auth].freeze
+      CURRENT = "plan"
+      SKIP_TARGET = "#content-wrapper"
+      HOST_LABEL = /\A(?!-)[a-z0-9-]{1,63}(?<!-)\z/
+
+      module_function
+
+      def valid_domain?(domain)
+        labels = domain.to_s.split(".")
+        labels.size >= 2 && labels.all? { |label| label.match?(HOST_LABEL) }
+      end
+
+      def domain(env: ENV, host_name: Setting.host_name)
+        configured = env["RAGFIT_ERYNOA_DOMAIN"].to_s.strip.downcase
+        return (valid_domain?(configured) ? configured : nil) unless configured.empty?
+
+        host = host_name.to_s.strip.downcase.sub(%r{\A[a-z]+://}, "").split(%r{[:/]}, 2).first.to_s
+        _first, rest = host.split(".", 2)
+        valid_domain?(rest) ? rest : nil
+      end
+
+      def home_url(domain, env: ENV)
+        configured = env["RAGFIT_ERYNOA_HOME_URL"].to_s.strip
+        return configured if configured.match?(%r{\Ahttps://[^\s"'<>]+\z})
+
+        "https://source.#{domain}/"
+      end
+
+      def service_url(service, domain)
+        "https://#{service}.#{domain}/"
+      end
+
+      # "dark", "light", or nil (follow the OS preference).
+      def theme(user = User.current)
+        pref = user&.pref
+        return nil if pref.nil? || pref.sync_with_os_theme?
+
+        pref.dark_color_mode? ? "dark" : "light"
+      end
+
+      def show?(params)
+        params.nil? || params[:layout].nil?
+      end
+
+      class Hook < OpenProject::Hook::ViewListener
+        render_on :view_layouts_base_html_head, partial: "ragfit/erynoa_header_head"
+        render_on :view_layouts_base_body_top, partial: "ragfit/erynoa_header"
+      end
+    end
+  end
+end
diff --git a/public/erynoa/ragfit-plan-layout.css b/public/erynoa/ragfit-plan-layout.css
new file mode 100644
index 0000000..ab1cbe2
--- /dev/null
+++ b/public/erynoa/ragfit-plan-layout.css
@@ -0,0 +1,36 @@
+/* RagFit patch 0005 (erynoa-header): fit the Erynoa header above the OpenProject 17 layout.
+ * SPDX-License-Identifier: GPL-3.0-only — part of RagFit | Plan (see CHANGES-RAGFIT.md).
+ * OpenProject's body does not scroll; #content-wrapper and the menu sidebar take 100dvh minus the app header.
+ * The header bar sits in normal flow above #wrapper, so those heights also subtract its height.
+ * Breakpoints: the bar switches to --erh-height-mobile below 640px (package), OpenProject fixes its own header
+ * below 544px ($breakpoint-sm). z-index stays below OpenProject toasts (300). */
+:root {
+  --erh-position: relative;
+  --erh-z: 200;
+  --ragfit-erh-h: var(--erh-height);
+}
+@media (max-width: 639px) {
+  :root { --ragfit-erh-h: var(--erh-height-mobile); }
+}
+#content-wrapper,
+#main-menu #menu-sidebar {
+  height: calc(100dvh - var(--header-height) - var(--ragfit-erh-h));
+}
+@media screen and (max-width: 543px) {
+  .op-app-header { top: var(--ragfit-erh-h); }
+  /* the bar stays in normal flow above #wrapper, so OpenProject's own #main offset is still correct */
+  ._header-scrolled #main,
+  ._header-scrolled #content-wrapper,
+  ._header-scrolled #main-menu #menu-sidebar {
+    height: calc(100dvh - var(--ragfit-erh-h));
+  }
+}
+/* narrow phones (360px and up): all five service links fit without horizontal scrolling; browsers do not
+ * scroll a partly visible focused link into view, so a cut-off last link would stay cut off on Tab. */
+@media (max-width: 400px) {
+  .erh-nav ul { gap: 2px; }
+  .erh-nav a { padding: 0 4px; }
+}
+@media print {
+  #content-wrapper, #main-menu #menu-sidebar { height: auto; }
+}
diff --git a/spec/lib/open_project/ragfit/erynoa_header_spec.rb b/spec/lib/open_project/ragfit/erynoa_header_spec.rb
new file mode 100644
index 0000000..52cba5d
--- /dev/null
+++ b/spec/lib/open_project/ragfit/erynoa_header_spec.rb
@@ -0,0 +1,46 @@
+# frozen_string_literal: true
+
+require "spec_helper"
+
+RSpec.describe OpenProject::Ragfit::ErynoaHeader do
+  describe ".domain" do
+    it "drops the first label of the host name" do
+      expect(described_class.domain(env: {}, host_name: "plan.example.org")).to eq("example.org")
+      expect(described_class.domain(env: {}, host_name: "Plan.Example.org:443")).to eq("example.org")
+      expect(described_class.domain(env: {}, host_name: "https://plan.a.example.org/x")).to eq("a.example.org")
+    end
+
+    it "returns nil without a usable base domain" do
+      ["localhost:3000", "plan.localhost", "", nil, "plan..org", "plan.-x.org"].each do |host|
+        expect(described_class.domain(env: {}, host_name: host)).to be_nil, "host #{host.inspect}"
+      end
+    end
+
+    it "prefers RAGFIT_ERYNOA_DOMAIN and rejects invalid values" do
+      expect(described_class.domain(env: { "RAGFIT_ERYNOA_DOMAIN" => " Example.ORG " }, host_name: "x.y.z"))
+        .to eq("example.org")
+      expect(described_class.domain(env: { "RAGFIT_ERYNOA_DOMAIN" => "bad domain" }, host_name: "plan.example.org"))
+        .to be_nil
+    end
+  end
+
+  describe ".home_url" do
+    it "defaults to the source service and accepts an https override only" do
+      expect(described_class.home_url("example.org", env: {})).to eq("https://source.example.org/")
+      expect(described_class.home_url("example.org", env: { "RAGFIT_ERYNOA_HOME_URL" => "https://home.example.org/" }))
+        .to eq("https://home.example.org/")
+      ["http://home.example.org/", "javascript:alert(1)", "https://x\"onload"].each do |url|
+        expect(described_class.home_url("example.org", env: { "RAGFIT_ERYNOA_HOME_URL" => url }))
+          .to eq("https://source.example.org/")
+      end
+    end
+  end
+
+  describe ".theme" do
+    it "maps the user's theme" do
+      expect(described_class.theme(build_stubbed(:user, preferences: { theme: "dark" }))).to eq("dark")
+      expect(described_class.theme(build_stubbed(:user, preferences: { theme: "light" }))).to eq("light")
+      expect(described_class.theme(build_stubbed(:user, preferences: { theme: "sync_with_os" }))).to be_nil
+    end
+  end
+end
diff --git a/spec/requests/ragfit/erynoa_header_spec.rb b/spec/requests/ragfit/erynoa_header_spec.rb
new file mode 100644
index 0000000..f24a934
--- /dev/null
+++ b/spec/requests/ragfit/erynoa_header_spec.rb
@@ -0,0 +1,57 @@
+# frozen_string_literal: true
+
+require "spec_helper"
+
+RSpec.describe "RagFit Erynoa header", type: :rails_request do
+  def header_html
+    Nokogiri::HTML(response.body).at_css("body > header.erh")
+  end
+
+  context "with a host name that has a base domain", with_settings: { host_name: "plan.example.org" } do
+    it "renders the header as first element of the body, without JavaScript" do
+      get "/login"
+      header = header_html
+      expect(header).to be_present
+      first = Nokogiri::HTML(response.body).at_css("body").element_children.first
+      expect(first.name).to eq("header")
+      expect(first["class"]).to eq("erh")
+      expect(header["role"]).to eq("banner")
+      expect(header["data-erynoa-header"]).to eq("1.1.1")
+      expect(header.at_css("a.erh-skip")["href"]).to eq("#content-wrapper")
+      expect(header.at_css("a.erh-brand")["href"]).to eq("https://source.example.org/")
+      expect(header.css("nav a").map { |a| a["href"] })
+        .to eq(%w[source plan memory docs auth].map { |s| "https://#{s}.example.org/" })
+      expect(header.css("a[aria-current='page']").map { |a| a["data-erh-service"] }).to eq(["plan"])
+      expect(header.css("script")).to be_empty
+      expect(response.body).to include('href="/erynoa/1.1.1/erynoa-header.v1.css"')
+      expect(response.body).to include('href="/erynoa/ragfit-plan-layout.css"')
+      expect(response.body).not_to include("erynoa-header.v1.js")
+    end
+
+    it "sets data-erh-theme from the user's theme" do
+      login_as create(:user, preferences: { theme: "dark" })
+      get "/my/page"
+      expect(header_html["data-erh-theme"]).to eq("dark")
+    end
+
+    it "omits data-erh-theme when the user follows the OS" do
+      login_as create(:user, preferences: { theme: "sync_with_os" })
+      get "/my/page"
+      expect(header_html).to be_present
+      expect(header_html["data-erh-theme"]).to be_nil
+    end
+
+    it "is not rendered when the page is requested without layout decoration" do
+      get "/login", params: { layout: "false" }
+      expect(header_html).to be_nil
+    end
+  end
+
+  context "without a base domain", with_settings: { host_name: "localhost:3000" } do
+    it "renders neither the header nor its stylesheets" do
+      get "/login"
+      expect(header_html).to be_nil
+      expect(response.body).not_to include("/erynoa/")
+    end
+  end
+end
