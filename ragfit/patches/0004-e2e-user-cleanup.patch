diff --git a/app/services/ragfit/e2e_user_cleanup.rb b/app/services/ragfit/e2e_user_cleanup.rb
new file mode 100644
index 0000000..14c1e8f
--- /dev/null
+++ b/app/services/ragfit/e2e_user_cleanup.rb
@@ -0,0 +1,92 @@
+# frozen_string_literal: true
+
+# RagFit patch 0004 (e2e-user-cleanup, 2026-10-13): delete end-to-end test users.
+# GPLv3 §10 modification, see CHANGES-RAGFIT.md.
+#
+# Deletes only users whose login starts with a strict E2E prefix ("e2e-" or a longer prefix that starts
+# with it, e.g. "e2e-plan-"). Refuses the whole run, deleting nothing, if any selected user is an admin,
+# on the password-login bypass list, or does not match the prefix. Uses the upstream deletion
+# (Principals::DeleteJob, run synchronously, after marking the user deleted like Users::DeleteService).
+# Dry run by default. Logs and returns logins only.
+module Ragfit
+  class E2eUserCleanup
+    BASE_PREFIX = "e2e-"
+    PREFIX_FORMAT = /\Ae2e-[a-z0-9-]*\z/
+
+    Result = Struct.new(:selected, :deleted, :refused, :dry_run, :error, keyword_init: true) do
+      def success? = error.nil?
+    end
+
+    attr_reader :prefix, :logins, :dry_run, :log
+
+    # prefix: login prefix (default "e2e-"); logins: optional explicit list (each must match the prefix).
+    def initialize(prefix: BASE_PREFIX, logins: nil, dry_run: true, log: ->(line) { Rails.logger.info(line) })
+      @prefix = prefix.to_s.strip.downcase
+      @logins = logins&.map { |l| l.to_s.strip }&.reject(&:empty?)
+      @dry_run = dry_run
+      @log = log
+    end
+
+    def self.from_env(prefix_arg, env: ENV, log: ->(line) { puts line })
+      logins = env["RAGFIT_E2E_LOGINS"].to_s.split(",").map(&:strip).reject(&:empty?)
+      new(prefix: prefix_arg.presence || BASE_PREFIX,
+          logins: logins.presence,
+          dry_run: env["DRY_RUN"].to_s != "0",
+          log:)
+    end
+
+    def call
+      return failure("refused: prefix must start with '#{BASE_PREFIX}' (only [a-z0-9-])") unless valid_prefix?
+
+      if logins && (bad = logins.reject { |l| matches_prefix?(l) }).any?
+        return failure("refused: logins outside prefix '#{prefix}': #{bad.join(', ')}")
+      end
+
+      users = selected_users.to_a
+      refused = users.select { |u| protected?(u) }
+      if refused.any?
+        return failure("refused: protected users selected (admin or password-login bypass): " \
+                       "#{refused.map(&:login).join(', ')}", selected: users, refused:)
+      end
+
+      users.each { |u| log.call("#{dry_run ? 'would delete' : 'deleting'}: #{u.login}") }
+      users.each { |u| delete(u) } unless dry_run
+      log.call("#{dry_run ? 'dry run' : 'done'}: #{users.size} user(s) with prefix '#{prefix}'" \
+               "#{dry_run ? ' (set DRY_RUN=0 to delete)' : ''}")
+      Result.new(selected: users.map(&:login), deleted: dry_run ? [] : users.map(&:login), refused: [],
+                 dry_run:, error: nil)
+    end
+
+    private
+
+    def valid_prefix?
+      prefix.match?(PREFIX_FORMAT)
+    end
+
+    def matches_prefix?(login)
+      login.downcase.start_with?(prefix)
+    end
+
+    def selected_users
+      scope = User.not_builtin.where.not(status: User.statuses[:deleted])
+      scope = scope.where("LOWER(login) LIKE ?", "#{User.sanitize_sql_like(prefix)}%")
+      scope = scope.where("LOWER(login) IN (?)", logins.map(&:downcase)) if logins
+      scope.order(:login)
+    end
+
+    def protected?(user)
+      user.admin? || ::Users::PasswordLogin.bypass?(user) || !matches_prefix?(user.login)
+    end
+
+    def delete(user)
+      user.update_column(:status, User.statuses[:deleted])
+      ::Principals::DeleteJob.perform_now(user)
+    end
+
+    def failure(message, selected: [], refused: [])
+      log.call(message)
+      Result.new(selected: selected.map(&:login), deleted: [], refused: refused.map(&:login), dry_run:,
+                 error: message)
+    end
+  end
+end
diff --git a/lib/tasks/ragfit_e2e.rake b/lib/tasks/ragfit_e2e.rake
new file mode 100644
index 0000000..89332c1
--- /dev/null
+++ b/lib/tasks/ragfit_e2e.rake
@@ -0,0 +1,13 @@
+# frozen_string_literal: true
+
+# RagFit patch 0004 (e2e-user-cleanup): see Ragfit::E2eUserCleanup and README.
+namespace :ragfit do
+  namespace :e2e do
+    desc "Delete E2E test users by login prefix (default e2e-). Dry run unless DRY_RUN=0. " \
+         "Optional RAGFIT_E2E_LOGINS=a,b limits to these logins."
+    task :delete_users, [:prefix] => :environment do |_task, args|
+      result = Ragfit::E2eUserCleanup.from_env(args[:prefix]).call
+      exit(1) unless result.success?
+    end
+  end
+end
diff --git a/spec/services/ragfit/e2e_user_cleanup_spec.rb b/spec/services/ragfit/e2e_user_cleanup_spec.rb
new file mode 100644
index 0000000..8ca790d
--- /dev/null
+++ b/spec/services/ragfit/e2e_user_cleanup_spec.rb
@@ -0,0 +1,96 @@
+# frozen_string_literal: true
+
+require "spec_helper"
+
+RSpec.describe Ragfit::E2eUserCleanup do
+  let!(:e2e_a) { create(:user, login: "e2e-plan-a") }
+  let!(:e2e_b) { create(:user, login: "E2E-plan-b") }
+  let!(:other) { create(:user, login: "alice") }
+  let(:lines) { [] }
+  let(:log) { ->(line) { lines << line } }
+
+  def run(**)
+    described_class.new(log:, **).call
+  end
+
+  it "is a dry run by default and deletes nothing" do
+    result = run
+    expect(result).to be_success
+    expect(result.selected).to contain_exactly("e2e-plan-a", "E2E-plan-b")
+    expect(result.deleted).to be_empty
+    expect(User.where(id: [e2e_a.id, e2e_b.id]).count).to eq(2)
+    expect(lines.join("\n")).to include("would delete: e2e-plan-a").and include("DRY_RUN=0")
+  end
+
+  it "deletes only users with the prefix when dry_run is false" do
+    result = run(prefix: "e2e-plan-", dry_run: false)
+    expect(result.deleted).to contain_exactly("e2e-plan-a", "E2E-plan-b")
+    expect(User.exists?(e2e_a.id)).to be(false)
+    expect(User.exists?(e2e_b.id)).to be(false)
+    expect(User.exists?(other.id)).to be(true)
+  end
+
+  it "limits deletion to RAGFIT_E2E_LOGINS" do
+    result = run(logins: ["e2e-plan-a"], dry_run: false)
+    expect(result.deleted).to eq(["e2e-plan-a"])
+    expect(User.exists?(e2e_b.id)).to be(true)
+  end
+
+  it "refuses logins outside the prefix" do
+    result = run(logins: %w[e2e-plan-a alice], dry_run: false)
+    expect(result).not_to be_success
+    expect(User.exists?(e2e_a.id)).to be(true)
+    expect(User.exists?(other.id)).to be(true)
+  end
+
+  it "refuses prefixes that are not strict E2E prefixes" do
+    ["", "e2e", "e2", "test-", "e2e-%", "e2e_x", "a"].each do |prefix|
+      expect(run(prefix:, dry_run: false)).not_to be_success, "prefix #{prefix.inspect} must be refused"
+    end
+    expect(User.where(id: [e2e_a.id, e2e_b.id, other.id]).count).to eq(3)
+  end
+
+  it "refuses the whole run if an admin matches the prefix" do
+    create(:admin, login: "e2e-admin")
+    result = run(dry_run: false)
+    expect(result).not_to be_success
+    expect(result.refused).to eq(["e2e-admin"])
+    expect(User.exists?(e2e_a.id)).to be(true)
+  end
+
+  it "refuses the whole run if a password-login bypass user matches" do
+    allow(Users::PasswordLogin).to receive(:bypass?).and_call_original
+    allow(Users::PasswordLogin).to receive(:bypass?).with(e2e_b).and_return(true)
+    result = run(dry_run: false)
+    expect(result).not_to be_success
+    expect(result.refused).to eq(["E2E-plan-b"])
+    expect(User.exists?(e2e_a.id)).to be(true)
+  end
+
+  it "logs logins only" do
+    run
+    expect(lines.join("\n")).not_to include(e2e_a.mail)
+  end
+
+  describe ".from_env" do
+    it "reads DRY_RUN and RAGFIT_E2E_LOGINS" do
+      cleanup = described_class.from_env(nil, env: { "DRY_RUN" => "0", "RAGFIT_E2E_LOGINS" => " e2e-plan-a , " }, log:)
+      expect(cleanup.dry_run).to be(false)
+      expect(cleanup.logins).to eq(["e2e-plan-a"])
+      expect(cleanup.prefix).to eq("e2e-")
+      expect(described_class.from_env("e2e-x-", env: {}, log:).dry_run).to be(true)
+    end
+  end
+
+  describe "rake task" do
+    before do
+      Rails.application.load_tasks unless Rake::Task.task_defined?("ragfit:e2e:delete_users")
+      Rake::Task["ragfit:e2e:delete_users"].reenable
+    end
+
+    it "runs as a dry run" do
+      expect { Rake::Task["ragfit:e2e:delete_users"].invoke("e2e-plan-") }.to output(/would delete: e2e-plan-a/).to_stdout
+      expect(User.exists?(e2e_a.id)).to be(true)
+    end
+  end
+end
