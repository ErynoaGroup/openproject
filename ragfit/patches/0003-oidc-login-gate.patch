--- /dev/null
+++ b/modules/openid_connect/lib/open_project/openid_connect/ragfit_login_gate.rb
@@ -0,0 +1,129 @@
+# frozen_string_literal: true
+
+# RagFit patch 0003 (oidc-login-gate, 2026-10-13): allow an OIDC login only for members of listed teams.
+# GPLv3 §10 modification, see CHANGES-RAGFIT.md.
+#
+# Rule: OIDC logins are authorized only on a full team claim "<org>:<team>". For every OpenID Connect
+# provider, RAGFIT_OIDC_<PROVIDER>_LOGIN_GROUPS (comma-separated team claims, e.g. "ErynoaGroup:plan-user")
+# lists the teams that may sign in; the provider's RAGFIT_OIDC_<PROVIDER>_ADMIN_GROUP counts as well.
+# A login is approved only if the userinfo "groups" claim contains one of them. Otherwise it is rejected
+# before any user is looked up, created or updated (upstream OmniAuth authorization callback, checked in
+# Authentication::OmniauthAuthHashContract). Fail closed: a missing "groups" claim, or a provider without
+# a valid LOGIN_GROUPS value, rejects every login of that provider (error logged at boot for providers
+# configured through OPENPROJECT_OPENID__CONNECT_<NAME>_* variables).
+#
+# Matching: claim entries must be strings and equal a team exactly, case-insensitive (Gitea lower-cases
+# team names). Claim entries are NOT trimmed: " ErynoaGroup:plan-user" or "ErynoaGroup:plan-user-x" do not
+# match. Only the variable's own entries are trimmed when parsed; entries that are not "<org>:<team>"
+# with non-empty parts are ignored with a warning. Only OpenID Connect providers are gated; other auth
+# providers are approved unchanged.
+#
+# Password login: users linked to an OpenID Connect provider (user_auth_provider_links) cannot sign in
+# with a password or API basic auth (Users::PasswordLogin.allowed? returns false), so the gate cannot be
+# bypassed. Local accounts without such a link (e.g. a break-glass admin) keep password login.
+module OpenProject::OpenIDConnect::RagfitLoginGate
+  module_function
+
+  def env_name(provider_name)
+    "RAGFIT_OIDC_#{provider_name.to_s.upcase.gsub(/[^A-Z0-9]/, '_')}_LOGIN_GROUPS"
+  end
+
+  def log_warn(message)
+    defined?(Rails) && Rails.logger ? Rails.logger.warn(message) : warn(message)
+  end
+
+  def team_claim?(entry)
+    org, team = entry.split(":", 2)
+    !org.to_s.strip.empty? && !team.to_s.strip.empty? && !team.include?(":")
+  end
+
+  # Allowed teams for a provider (downcased); empty when nothing valid is configured (= reject all).
+  def allowed_groups(provider_name, env: ENV)
+    raw = env[env_name(provider_name)].to_s
+    return [] if raw.strip.empty?
+
+    allowed = raw.split(",").map(&:strip).reject(&:empty?).select do |entry|
+      team_claim?(entry).tap do |ok|
+        log_warn("RagFit: #{env_name(provider_name)} entry ignored, expected '<org>:<team>'") unless ok
+      end
+    end
+    return [] if allowed.empty?
+
+    admin = env[OpenProject::OpenIDConnect::RagfitAdminGroup.env_name(provider_name)].to_s.strip
+    allowed << admin if !admin.empty? && team_claim?(admin)
+    allowed.map(&:downcase).uniq
+  end
+
+  # true: approve, false: reject.
+  def allowed?(provider_name, raw_info, env: ENV)
+    allowed = allowed_groups(provider_name, env:)
+    return false if allowed.empty?
+
+    groups = raw_info.respond_to?(:[]) ? (raw_info["groups"] || raw_info[:groups]) : nil
+    return false unless groups.is_a?(Array)
+
+    groups.any? { |g| g.is_a?(String) && allowed.include?(g.downcase) }
+  end
+
+  def oidc_provider?(slug)
+    provider = ::AuthProvider.find_by(slug: slug.to_s)
+    provider.nil? || provider.is_a?(::OpenIDConnect::Provider)
+  rescue StandardError
+    true
+  end
+
+  # Upstream extension point: OpenProject::OmniAuth::Authorization callback.
+  def authorize(decision, auth_hash, env: ENV)
+    provider = auth_hash&.provider.to_s
+    return decision.approve if provider.empty? || !oidc_provider?(provider)
+
+    raw_info = auth_hash.dig("extra", "raw_info") || {}
+    return decision.approve if allowed?(provider, raw_info, env:)
+
+    login = raw_info["preferred_username"] || raw_info[:preferred_username] || auth_hash["uid"]
+    reason = allowed_groups(provider, env:).empty? ? "no valid #{env_name(provider)}" : "no allowed team"
+    log_warn("RagFit login gate: OIDC login via '#{provider}' rejected for '#{login}' (#{reason})")
+    decision.reject(I18n.t("user.authorization_rejected"))
+  end
+
+  def register!
+    return if @registered
+
+    OpenProject::OmniAuth::Authorization.authorize_user do |decision, auth_hash|
+      authorize(decision, auth_hash)
+    end
+    ::Users::PasswordLogin.singleton_class.prepend(PasswordLoginPatch)
+    @registered = true
+    check_env_providers!
+  end
+
+  # Providers configured through OPENPROJECT_OPENID__CONNECT_<NAME>_* (env seed), by slug.
+  def env_providers(env: ENV)
+    env.keys.filter_map { |k| k[/\AOPENPROJECT_OPENID__CONNECT_([A-Z0-9]+)_/, 1] }.uniq.map(&:downcase)
+  end
+
+  # Boot check: an OIDC provider without a valid LOGIN_GROUPS value rejects every login.
+  def check_env_providers!(env: ENV)
+    env_providers(env:).each do |slug|
+      next unless allowed_groups(slug, env:).empty?
+
+      message = "RagFit login gate: #{env_name(slug)} empty or invalid, every OIDC login via '#{slug}' is rejected"
+      defined?(Rails) && Rails.logger ? Rails.logger.error(message) : warn(message)
+    end
+  end
+
+  # True if the user is linked to an OpenID Connect provider.
+  def oidc_linked?(user)
+    return false unless user.respond_to?(:user_auth_provider_links)
+
+    user.user_auth_provider_links.any? { |link| link.auth_provider.is_a?(::OpenIDConnect::Provider) }
+  end
+
+  module PasswordLoginPatch
+    def allowed?(user)
+      return false if user.present? && OpenProject::OpenIDConnect::RagfitLoginGate.oidc_linked?(user)
+
+      super
+    end
+  end
+end
diff --git a/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_login_gate_spec.rb b/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_login_gate_spec.rb
new file mode 100644
index 0000000..4c5d197
--- /dev/null
+++ b/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_login_gate_spec.rb
@@ -0,0 +1,132 @@
+# frozen_string_literal: true
+
+require "spec_helper"
+
+RSpec.describe OpenProject::OpenIDConnect::RagfitLoginGate do
+  let(:env) do
+    {
+      "RAGFIT_OIDC_SOURCE_LOGIN_GROUPS" => " ErynoaGroup:plan-user , ErynoaGroup:qa ",
+      "RAGFIT_OIDC_SOURCE_ADMIN_GROUP" => "ErynoaGroup:platform-admin"
+    }
+  end
+
+  def gate_hash(raw_info, provider = "source")
+    OmniAuth::AuthHash.new("provider" => provider, "uid" => "u1", "extra" => { "raw_info" => raw_info })
+  end
+
+  def decide(hash, env: self.env)
+    store = OpenProject::OmniAuth::Authorization::DecisionStore.new
+    described_class.authorize(store, hash, env:)
+    store.decision
+  end
+
+  before { allow(Rails.logger).to receive(:warn) }
+
+  it "rejects a login without an allowed team" do
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup ErynoaGroup:dev]))).to be_reject
+  end
+
+  it "approves a login with an allowed team (case-insensitive)" do
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup erynoagroup:PLAN-USER]))).to be_approve
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:qa]))).to be_approve
+  end
+
+  it "approves a login with only the admin group" do
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:platform-admin]))).to be_approve
+  end
+
+  it "rejects when the groups claim is missing or not an array (fail closed)" do
+    expect(decide(gate_hash({}))).to be_reject
+    expect(decide(gate_hash("groups" => "ErynoaGroup:plan-user"))).to be_reject
+  end
+
+  it "matches claim entries exactly: no trimming, no prefix or substring match" do
+    expect(decide(gate_hash("groups" => [" ErynoaGroup:plan-user"]))).to be_reject
+    expect(decide(gate_hash("groups" => ["ErynoaGroup:plan-user "]))).to be_reject
+    expect(decide(gate_hash("groups" => ["ErynoaGroup:plan-user-x"]))).to be_reject
+    expect(decide(gate_hash("groups" => ["ErynoaGroup:plan"]))).to be_reject
+  end
+
+  it "ignores non-string claim entries" do
+    expect(decide(gate_hash("groups" => [nil, 1, :"ErynoaGroup:plan-user", ["ErynoaGroup:plan-user"]]))).to be_reject
+  end
+
+  it "rejects every login when the variable is not set or blank (fail closed)" do
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:plan-user]), env: {})).to be_reject
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:plan-user]), env: { "RAGFIT_OIDC_SOURCE_LOGIN_GROUPS" => "  " }))
+      .to be_reject
+  end
+
+  it "does not let the admin group alone open the gate without LOGIN_GROUPS" do
+    admin_only = { "RAGFIT_OIDC_SOURCE_ADMIN_GROUP" => "ErynoaGroup:platform-admin" }
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:platform-admin]), env: admin_only)).to be_reject
+  end
+
+  it "ignores invalid entries with a warning and keeps the valid ones" do
+    gate = { "RAGFIT_OIDC_SOURCE_LOGIN_GROUPS" => "ErynoaGroup, :x, y:, ErynoaGroup:plan-user, a:b:c" }
+    expect(described_class.allowed_groups("source", env: gate)).to eq(["erynoagroup:plan-user"])
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup]), env: gate)).to be_reject
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup:plan-user]), env: gate)).to be_approve
+    expect(Rails.logger).to have_received(:warn).with(/LOGIN_GROUPS entry ignored/).at_least(4).times
+  end
+
+  it "rejects every login when only invalid entries are set" do
+    expect(decide(gate_hash("groups" => %w[ErynoaGroup]), env: { "RAGFIT_OIDC_SOURCE_LOGIN_GROUPS" => "ErynoaGroup" }))
+      .to be_reject
+  end
+
+  it "rejects an OIDC provider without its own LOGIN_GROUPS" do
+    expect(decide(gate_hash({ "groups" => %w[ErynoaGroup:plan-user] }, "other"))).to be_reject
+  end
+
+  it "logs an error at boot for env-configured providers without valid LOGIN_GROUPS" do
+    allow(Rails.logger).to receive(:error)
+    boot_env = {
+      "OPENPROJECT_OPENID__CONNECT_SOURCE_IDENTIFIER" => "x",
+      "OPENPROJECT_OPENID__CONNECT_OTHER_IDENTIFIER" => "y",
+      "RAGFIT_OIDC_SOURCE_LOGIN_GROUPS" => "ErynoaGroup:plan-user"
+    }
+    described_class.check_env_providers!(env: boot_env)
+    expect(Rails.logger).to have_received(:error).with(/RAGFIT_OIDC_OTHER_LOGIN_GROUPS empty or invalid/).once
+    expect(Rails.logger).not_to have_received(:error).with(/RAGFIT_OIDC_SOURCE_LOGIN_GROUPS/)
+  end
+
+  it "does not gate auth providers that are not OpenID Connect" do
+    allow(AuthProvider).to receive(:find_by).with(slug: "source").and_return(AuthProvider.new)
+    expect(decide(gate_hash({}))).to be_approve
+  end
+
+  it "logs the rejection with the login only" do
+    decide(gate_hash("groups" => %w[ErynoaGroup], "preferred_username" => "jdoe", "email" => "x"))
+    expect(Rails.logger).to have_received(:warn).with(/rejected for 'jdoe'/)
+  end
+
+  it "is registered as an OmniAuth authorization callback" do
+    stub_const("ENV", ENV.to_h.merge(env))
+    expect(OpenProject::OmniAuth::Authorization.authorized?(gate_hash("groups" => %w[ErynoaGroup]))).to be_reject
+    expect(OpenProject::OmniAuth::Authorization.authorized?(gate_hash("groups" => %w[ErynoaGroup:plan-user])))
+      .to be_approve
+  end
+
+  describe "password login" do
+    let(:oidc_provider) { create(:oidc_provider, slug: "source") }
+    let(:linked) { create(:user, password: "adminADMIN!1", password_confirmation: "adminADMIN!1") }
+    let(:local) { create(:user, password: "adminADMIN!1", password_confirmation: "adminADMIN!1") }
+
+    before do
+      UserAuthProviderLink.create!(principal: linked, auth_provider: oidc_provider, external_id: "ext-1")
+      linked.reload
+    end
+
+    it "is refused for a user linked to an OpenID Connect provider" do
+      expect(Users::PasswordLogin.allowed?(linked)).to be(false)
+      expect(linked.check_password?("adminADMIN!1")).to be(false)
+      expect(User.try_to_login(linked.login, "adminADMIN!1")).to be_nil
+    end
+
+    it "stays allowed for a local account without an OIDC link" do
+      expect(Users::PasswordLogin.allowed?(local)).to be(true)
+      expect(User.try_to_login(local.login, "adminADMIN!1")).to eq(local)
+    end
+  end
+end
