+++ b/modules/openid_connect/lib/open_project/openid_connect/ragfit_admin_group.rb
@@ -0,0 +1,43 @@
+# frozen_string_literal: true
+
+# RagFit patch 0002 (oidc-admin-group, 2026-10-13): set the admin flag from a group claim on every OIDC login.
+# GPLv3 §10 modification, see CHANGES-RAGFIT.md.
+#
+# Upstream maps "admin" only from a boolean claim (attribute_map admin). Some providers only send a
+# "groups" array (e.g. "org" and "org:team" entries). With RAGFIT_OIDC_<PROVIDER>_ADMIN_GROUP set, the
+# strategy returns admin: true when that group is in the userinfo "groups" claim and admin: false when the
+# claim is present but does not contain it. Authentication::OmniauthService#update_admin_flag then grants
+# or revokes admin on every login. Without the variable (or a blank one), or without a "groups" claim,
+# nothing changes.
+#
+# Exactly one group per provider: the variable holds a single group name, not a list. Entries in the claim
+# that are not strings are ignored. The comparison is case-insensitive and exact (no prefix match).
+# RagFit | Source (Gitea) builds team entries as org.Name + ":" + lower-case team name, e.g.
+# "ErynoaGroup:platform-admin"; set the variable to exactly that string.
+module OpenProject::OpenIDConnect::RagfitAdminGroup
+  module_function
+
+  def env_name(provider_name)
+    "RAGFIT_OIDC_#{provider_name.to_s.upcase.gsub(/[^A-Z0-9]/, '_')}_ADMIN_GROUP"
+  end
+
+  # Returns true, false or nil (nil: do not touch the admin flag).
+  def admin_for(provider_name, raw_info, env: ENV)
+    group = env[env_name(provider_name)].to_s.strip
+    return nil if group.empty?
+
+    groups = raw_info.respond_to?(:[]) ? (raw_info["groups"] || raw_info[:groups]) : nil
+    return nil unless groups.is_a?(Array)
+
+    groups.any? { |g| g.is_a?(String) && g.strip.casecmp?(group) }
+  end
+
+  module StrategyPatch
+    def omniauth_hash_to_user_attributes(auth_hash)
+      attributes = defined?(super) ? super : {}
+      raw_info = auth_hash.dig("extra", "raw_info") || {}
+      admin = OpenProject::OpenIDConnect::RagfitAdminGroup.admin_for(name, raw_info)
+      admin.nil? ? attributes : attributes.merge(admin:)
+    end
+  end
+end
diff --git a/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_admin_group_spec.rb b/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_admin_group_spec.rb
new file mode 100644
index 0000000..9efc1ec
--- /dev/null
+++ b/modules/openid_connect/spec/lib/open_project/openid_connect/ragfit_admin_group_spec.rb
@@ -0,0 +1,68 @@
+# frozen_string_literal: true
+
+require "spec_helper"
+
+RSpec.describe OpenProject::OpenIDConnect::RagfitAdminGroup do
+  let(:env) { { "RAGFIT_OIDC_SOURCE_ADMIN_GROUP" => "acme:platform-admin" } }
+
+  describe ".admin_for" do
+    it "is true when the group is in the claim (case-insensitive)" do
+      expect(described_class.admin_for("source", { "groups" => %w[acme Acme:Platform-Admin] }, env:)).to be(true)
+    end
+
+    it "is false when the claim is present without the group, so admin is revoked" do
+      expect(described_class.admin_for("source", { "groups" => %w[acme acme:dev] }, env:)).to be(false)
+      expect(described_class.admin_for("source", { "groups" => [] }, env:)).to be(false)
+    end
+
+    it "is nil without a groups claim" do
+      expect(described_class.admin_for("source", {}, env:)).to be_nil
+      expect(described_class.admin_for("source", { "groups" => "acme:platform-admin" }, env:)).to be_nil
+    end
+
+    it "is nil when the variable is not set for this provider" do
+      expect(described_class.admin_for("other", { "groups" => %w[acme:platform-admin] }, env:)).to be_nil
+      expect(described_class.admin_for("source", { "groups" => %w[acme:platform-admin] }, env: {})).to be_nil
+    end
+
+    it "is nil when the variable is blank (whitespace only), so admin stays unchanged" do
+      blank = { "RAGFIT_OIDC_SOURCE_ADMIN_GROUP" => "  \t " }
+      expect(described_class.admin_for("source", { "groups" => %w[acme:platform-admin] }, env: blank)).to be_nil
+      expect(described_class.admin_for("source", { "groups" => [] }, env: blank)).to be_nil
+    end
+
+    it "reads the claim from a symbol key :groups like \"groups\"" do
+      expect(described_class.admin_for("source", { groups: %w[acme:platform-admin] }, env:)).to be(true)
+      expect(described_class.admin_for("source", { groups: %w[acme:dev] }, env:)).to be(false)
+    end
+
+    it "ignores entries that are not strings without raising" do
+      groups = [nil, 42, :"acme:platform-admin", { "name" => "acme:platform-admin" }, ["acme:platform-admin"]]
+      expect(described_class.admin_for("source", { "groups" => groups }, env:)).to be(false)
+      expect(described_class.admin_for("source", { "groups" => groups + ["acme:platform-admin"] }, env:)).to be(true)
+    end
+
+    it "does not match a group that only shares a prefix" do
+      expect(described_class.admin_for("source", { "groups" => %w[acme:platform-admins] }, env:)).to be(false)
+    end
+  end
+
+  describe "strategy patch" do
+    it "is prepended to the OpenID Connect strategy" do
+      expect(OmniAuth::Strategies::OpenIDConnect.ancestors).to include(described_class::StrategyPatch)
+    end
+
+    it "adds admin to the user attributes, also false" do
+      strategy = OmniAuth::Strategies::OpenIDConnect.new(nil, name: "source")
+      hash = OmniAuth::AuthHash.new(extra: { raw_info: { "groups" => %w[acme:dev] } })
+      stub_const("ENV", ENV.to_h.merge(env))
+      expect(strategy.omniauth_hash_to_user_attributes(hash)).to include(admin: false)
+    end
+
+    it "adds nothing without a groups claim" do
+      strategy = OmniAuth::Strategies::OpenIDConnect.new(nil, name: "source")
+      stub_const("ENV", ENV.to_h.merge(env))
+      expect(strategy.omniauth_hash_to_user_attributes(OmniAuth::AuthHash.new(extra: { raw_info: {} }))).not_to have_key(:admin)
+    end
+  end
+end
